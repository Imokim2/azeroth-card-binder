{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "..",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "allowJs": false
  },
  "include": ["src/**/*.ts", "electron/**/*.ts"],
  "exclude": ["test", "tools", "dist", "node_modules"]
}
